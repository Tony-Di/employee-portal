<!doctype html>
<html lang="<%= lang === 'en' ? 'en' : 'zh-CN' %>"<% if (theme) { %> data-theme="<%= theme %>"<% } %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <% if (typeof csrf !== 'undefined' && csrf) { %><meta name="csrf-token" content="<%= csrf %>"><% } %>
  <meta name="color-scheme" content="<%= theme || 'light dark' %>">
  <link rel="icon" href="/static/favicon.svg?v=2" type="image/svg+xml">
  <link rel="stylesheet" href="/static/css/portal.css">
  <script src="/static/js/theme.js" defer></script>
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">

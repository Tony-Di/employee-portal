<%# Brand mark: an uploaded logo when set, otherwise the SEG Solar logo in the variant that suits the background. %>
<% if (typeof customLogo !== 'undefined' && customLogo) { %><img class="logo-custom" src="<%= customLogo %>" alt="<%= typeof alt !== 'undefined' ? alt : 'SEG Solar' %>"><% } else if (typeof variant !== 'undefined' && variant === 'white') { %><img class="logo" src="/static/brand/seg-logo-white.svg" alt="SEG Solar" width="180" height="30"><% } else { %><img class="logo logo-light" src="/static/brand/seg-logo.svg" alt="SEG Solar" width="180" height="30"><img class="logo logo-dark" src="/static/brand/seg-logo-white.svg" alt="SEG Solar" width="180" height="30"><% } %>

<%
  const otherLang = lang === 'en' ? 'zh' : 'en';
  const nextTheme = theme === 'dark' ? 'light' : 'dark';
%><div class="prefs">
  <a class="lang-switch" href="<%= switchUrl('lang', otherLang) %>" lang="<%= otherLang === 'en' ? 'en' : 'zh-CN' %>"><%= lang === 'en' ? '中文' : 'English' %></a>
  <a class="theme-toggle" href="<%= switchUrl('theme', nextTheme) %>" data-theme-toggle
     data-label-dark="<%= t('切换到深色模式', 'Switch to dark mode') %>" data-label-light="<%= t('切换到浅色模式', 'Switch to light mode') %>"
     aria-label="<%= nextTheme === 'dark' ? t('切换到深色模式', 'Switch to dark mode') : t('切换到浅色模式', 'Switch to light mode') %>"
     title="<%= nextTheme === 'dark' ? t('切换到深色模式', 'Switch to dark mode') : t('切换到浅色模式', 'Switch to light mode') %>">
    <svg class="icon icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
    <svg class="icon icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></svg>
  </a>
</div>

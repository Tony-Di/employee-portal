{
  "name": "employee-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A small employee application directory with an administrator console.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "setup": "node scripts/setup.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "admin": "node --env-file-if-exists=.env scripts/admin.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 tests/*.test.js",
    "check": "node scripts/check.js"
  },
  "dependencies": {
    "connect-pg-simple": "10.0.0",
    "ejs": "6.0.1",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "express-session": "1.19.0",
    "file-type": "22.1.0",
    "helmet": "8.3.0",
    "multer": "2.4.0",
    "nodemailer": "10.0.10",
    "openid-client": "6.8.8",
    "pg": "8.23.0"
  }
}
